# Frontend (safe to expose in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets (server-side only — set with
# `supabase secrets set`, never prefix with VITE_ or these will be
# bundled into client-side JavaScript)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FIRECRAWL_API_KEY=
